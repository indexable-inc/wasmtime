test compile
set enable_pcc=true
target x86_64

;; A bounds check whose adjusted bound is 0 (spec `address.wast`:
;; `i32.load8_u offset=4294967295` under a 4 GiB reservation): the
;; compare is against zero, which x64 lowers to `test` plus `cmovne`.
function %ugt_zero(i64, i32) -> i32 {
    mt0 = memory 0x1_0200_0000
block0(v0 ! mem(mt0, 0, 0): i64, v1: i32):
    v3 ! def(v1) = uextend.i64 v1
    v4 ! range(64, 0, 0) = iconst.i64 0
    v5 ! compare(ugt, v1, 0) = icmp ugt v3, v4
    v7 ! dynamic_mem(mt0, v1, v1) = iadd v0, v3
    v8 ! range(64, 0xffffffff, 0xffffffff) = iconst.i64 0xffff_ffff
    v9 ! dynamic_mem(mt0, v1, v1+0xffffffff) = iadd v7, v8
    v10 ! range(64, 0, 0) = iconst.i64 0
    v11 ! mem(mt0, 0, 0xffffffff, nullable) = select_spectre_guard v5, v10, v9
    v12 = uload8.i32 checked v11
    return v12
}

;; The same with the compare written as `ne` (what the egraph folds
;; `ugt x, 0` to).
function %ne_zero(i64, i32) -> i32 {
    mt0 = memory 0x1_0200_0000
block0(v0 ! mem(mt0, 0, 0): i64, v1: i32):
    v3 ! def(v1) = uextend.i64 v1
    v4 ! range(64, 0, 0) = iconst.i64 0
    v5 ! compare(ugt, v1, 0) = icmp ne v3, v4
    v7 ! dynamic_mem(mt0, v1, v1) = iadd v0, v3
    v8 ! range(64, 0xffffffff, 0xffffffff) = iconst.i64 0xffff_ffff
    v9 ! dynamic_mem(mt0, v1, v1+0xffffffff) = iadd v7, v8
    v10 ! range(64, 0, 0) = iconst.i64 0
    v11 ! mem(mt0, 0, 0xffffffff, nullable) = select_spectre_guard v5, v10, v9
    v12 = uload8.i32 checked v11
    return v12
}

;; The egraph narrows `icmp ugt (uextend x), 0` to `icmp ne x, 0` on the
;; i32 itself, which lowers to `testl x, x`: the checker relates it to the
;; `movl` (uextend) that defines the index symbol.
function %ne_zero_i32(i64, i32) -> i32 {
    mt0 = memory 0x1_0200_0000
block0(v0 ! mem(mt0, 0, 0): i64, v1: i32):
    v3 ! def(v1) = uextend.i64 v1
    v4 = iconst.i32 0
    v5 ! compare(ugt, v1, 0) = icmp ne v1, v4
    v7 ! dynamic_mem(mt0, v1, v1) = iadd v0, v3
    v8 ! range(64, 0xffffffff, 0xffffffff) = iconst.i64 0xffff_ffff
    v9 ! dynamic_mem(mt0, v1, v1+0xffffffff) = iadd v7, v8
    v10 ! range(64, 0, 0) = iconst.i64 0
    v11 ! mem(mt0, 0, 0xffffffff, nullable) = select_spectre_guard v5, v10, v9
    v12 = uload8.i32 checked v11
    return v12
}
