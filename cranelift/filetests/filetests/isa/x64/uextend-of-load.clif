function %uload16_uextend(i64) -> i64 {
block0(v0: i64):
    v1 = uload16.i32 v0
    v2 = iadd v1, v1
    v3 = uextend.i64 v1
    v4 = uextend.i64 v2
    v5 = iadd v3, v4
    return v5
}

