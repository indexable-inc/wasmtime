test compile precise-output
set opt_level=speed
target x86_64

;; A 32-bit load already zeroes the upper half of its destination, so the
;; `uextend` that forms the next wasm32 heap address needs no `movl`.
function %chase(i64, i64) -> i32 {
block0(v0: i64, v1: i64):
    v2 = load.i32 little v1
    v3 = uextend.i64 v2
    v4 = iadd v0, v3
    v5 = load.i32 little v4
    v6 = uextend.i64 v5
    v7 = iadd v0, v6
    v8 = load.i32 little v7
    v9 = iadd v8, v2
    return v9
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movl (%rsi), %eax
;   movl (%rdi, %rax), %esi
;   addl (%rdi, %rsi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movl (%rsi), %eax ; trap: heap_oob
;   movl (%rdi, %rax), %esi ; trap: heap_oob
;   addl (%rdi, %rsi), %eax ; trap: heap_oob
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %uload8_uextend(i64) -> i64 {
block0(v0: i64):
    v1 = uload8.i32 v0
    v2 = iadd v1, v1
    v3 = uextend.i64 v1
    v4 = uextend.i64 v2
    v5 = iadd v3, v4
    return v5
}

