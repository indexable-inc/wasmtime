;; The masked value is a load: it stays a full-width load into a register,
;; never a narrower read of memory.
function %mask8_of_load(i64) -> i32 {
block0(v0: i64):
    v1 = load.i32 little v0
    v2 = iconst.i32 0xff
    v3 = band v1, v2
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movl (%rdi), %esi
;   movzbl %sil, %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movl (%rdi), %esi ; trap: heap_oob
;   movzbl %sil, %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; Other masks are still an `and`.
function %mask7f(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0x7f
    v2 = band v0, v1
    return v2
}

