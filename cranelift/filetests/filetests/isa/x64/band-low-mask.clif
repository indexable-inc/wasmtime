test compile precise-output
set opt_level=speed
target x86_64

;; Masking to the low 8, 16 or 32 bits is a zero-extending move: no copy of
;; `v0`, which stays live.
function %mask8_i32(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0xff
    v2 = band v0, v1
    v3 = iadd v2, v0
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movzbl %dil, %esi
;   leal (%rsi, %rdi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movzbl %dil, %esi
;   leal (%rsi, %rdi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %mask16_i32(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0xffff
    v2 = band v0, v1
    v3 = iadd v2, v0
    return v3
}

