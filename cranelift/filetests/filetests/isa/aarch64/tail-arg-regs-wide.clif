test compile precise-output
set tail_arg_regs=wide
set preserve_frame_pointers
target aarch64

;; `tail` with more integer argument registers (wide).

function %callee10(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64):
    v10 = iadd v6, v7
    v11 = iadd v8, v9
    v12 = iadd v10, v11
    return v12
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   add x7, x9, x10
;   add x8, x11, x12
;   add x2, x7, x8
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   add x7, x9, x10
;   add x8, x11, x12
;   add x2, x7, x8
;   ldp x29, x30, [sp], #0x10
;   ret

function %caller10(i64) -> i64 tail {
    fn0 = %callee10(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
block0(v0: i64):
    v1 = call fn0(v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
    return v1
}

