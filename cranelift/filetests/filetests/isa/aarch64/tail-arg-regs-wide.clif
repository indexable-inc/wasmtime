;   mov x6, x12
;   mov x7, x12
;   mov x9, x12
;   mov x10, x12
;   mov x11, x12
;   blr x8
;   ldp x29, x30, [sp], #0x10
;   ret

function %tail_caller10(i64) -> i64 tail {
    fn0 = %callee10(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
block0(v0: i64):
    return_call fn0(v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
}

