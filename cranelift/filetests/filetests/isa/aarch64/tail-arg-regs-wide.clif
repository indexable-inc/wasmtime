function %tail_indirect10(i64, i64) -> i64 tail {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64):
    return_call_indirect sig0, v1(v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
}

