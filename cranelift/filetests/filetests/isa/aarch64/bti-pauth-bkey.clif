;; `return_call_indirect` branches with `br`, which a `bti c` landing pad
;; accepts only through x16/x17.
function %tail_return_call_indirect(i64, i64) -> i64 tail {
    sig0 = (i64) -> i64 tail

block0(v0: i64, v1: i64):
    return_call_indirect sig0, v1(v0)
}

; VCode:
;   bti c
; block0:
;   mov x1, x3
;   return_call_ind x1 new_stack_arg_size:0 x2=x2
;
; Disassembled:
; block0: ; offset 0x0
;   bti c
; block1: ; offset 0x4
;   mov x1, x3
;   mov x16, x1
;   br x16

